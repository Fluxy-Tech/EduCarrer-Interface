generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String       @default("user")
  banned        Boolean      @default(false)
  banReason     String?
  banExpires    DateTime?

  accounts      Account[]
  sessions      Session[]
  skills        Skill[]
  experiences   Experience[]
  study         Study[]
  avaliations   Avaliations[]
  resetPassWord ResetPassWord[]
  avaliationsVacancys AvaliationsVacancys[]
}

model ResetPassWord {
  id        String   @id @default(cuid())
  
  completed Boolean  @default(false)
  userId    String

  tokenToReset String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Skill {
  id         String   @id @default(cuid())
  name       String
  level      Int      @default(0)
  about      String?

  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id         String   @id @default(cuid())
  name       String
  seniority  String
  about      String
  startDate  DateTime?
  endDate    DateTime?
  currentJob Boolean @default(false)
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Study {
  id         String   @id @default(cuid())
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vacancyId  String
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sections   StudySection[]
}

model StudySection {
  id         String   @id @default(cuid())

  studyId    String
  study      Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  section    String
  type       String

  content    String?

  createdAt  DateTime @default(now())

  // Gamificação: cada seção é um nível que precisa do quiz aprovado para liberar o próximo
  completed   Boolean   @default(false)
  completedAt DateTime?
  bestScore   Int       @default(0)
  attempts    Int       @default(0)

  strengths  StudyStrength[]
  gaps       StudyGap[]
  plans      StudyPlan[]
  questions  StudyQuestion[]
}

model StudyQuestion {
  id          String       @id @default(cuid())

  sectionId   String
  section     StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  position    Int
  question    String       @db.Text
  options     String[]
  answerIndex Int
  explanation String       @db.Text

  createdAt   DateTime     @default(now())

  @@index([sectionId])
}

model StudyStrength {
  id          String @id @default(cuid())

  sectionId   String
  section     StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  skill       String
  importance  String @db.Text
  advice      String @db.Text
}

model StudyGap {
  id            String @id @default(cuid())

  sectionId     String
  section       StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  skill         String
  explanation   String @db.Text
  priority      String

  estimatedTime String

  topics        String[]
  resources     String[]
}


model StudyPlan {
  id          String @id @default(cuid())

  sectionId   String
  section     StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  week        Int
  focus       String
  goals       String @db.Text
}

model Vacancy {
  id            String   @id @default(cuid())
  title         String
  description   String?
  company       String?
  level         String?
  modality      String?
  technologies  String[]
  link          String?
  origin        String?
  location      String?
  salary        String? @default("0")
  active        Boolean @default(true)

  study         Study[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Avaliations {
  id         String   @id @default(cuid())
  satisfied  Boolean
  comment    String?

  studyId    String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
}

model AvaliationsVacancys {
  id         String   @id @default(cuid())
  satisfied  Boolean
  comment    String?

  createdAt  DateTime @default(now())

  userId     String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
}
