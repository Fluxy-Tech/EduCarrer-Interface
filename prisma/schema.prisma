generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String       @default("user")
  banned        Boolean      @default(false)
  banReason     String?
  banExpires    DateTime?

  // Créditos de IA: os do plano valem até planExpiresAt, os avulsos (extra) não expiram.
  // Todo usuário novo ganha 2.000 créditos avulsos de boas-vindas
  plan            String?
  planCredits     Int       @default(0)
  planExpiresAt   DateTime?
  extraCredits    Int       @default(2000)
  cpfCnpj         String?
  asaasCustomerId String?   @unique

  // Áreas de interesse (Backend, Frontend...) usadas no filtro do ranking dos recrutadores
  areasOfInterest  String[]  @default([])
  // Currículo no bucket; recrutadores só baixam quando resumeVisible = true
  resumeKey        String?
  resumeFileName   String?
  resumeVisible    Boolean   @default(false)
  resumeUploadedAt DateTime?
  // Links públicos do candidato, liberados ao recrutador depois do desbloqueio (+50 pontos no ranking)
  linkedinUrl      String?
  portfolioUrl     String?

  accounts      Account[]
  sessions      Session[]
  skills        Skill[]
  experiences   Experience[]
  study         Study[]
  avaliations   Avaliations[]
  resetPassWord ResetPassWord[]
  avaliationsVacancys AvaliationsVacancys[]
  history History[]
  subscriptions Subscription[]
  payments      Payment[]
  creditTransactions CreditTransaction[]
  vacancyFilter VacancyFilter?
  createdVacancies Vacancy[] @relation("VacancyCreatedBy")
  // Desbloqueios: como recrutador (unlocksMade) e como candidato desbloqueado (unlocksReceived)
  unlocksMade      CandidateUnlock[] @relation("UnlockRecruiter")
  unlocksReceived  CandidateUnlock[] @relation("UnlockCandidate")
}

model ResetPassWord {
  id        String   @id @default(cuid())
  
  completed Boolean  @default(false)
  userId    String

  tokenToReset String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Skill {
  id         String   @id @default(cuid())
  name       String
  level      Int      @default(0)
  about      String?

  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id         String   @id @default(cuid())
  name       String
  seniority  String
  about      String
  startDate  DateTime?
  endDate    DateTime?
  currentJob Boolean @default(false)
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Study {
  id         String   @id @default(cuid())
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vacancyId  String
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sections   StudySection[]
  history    History[]
}

model StudySection {
  id         String   @id @default(cuid())

  studyId    String
  study      Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  section    String
  type       String

  content    String?

  createdAt  DateTime @default(now())

  strengths  StudyStrength[]
  gaps       StudyGap[]
  plans      StudyPlan[]
}

model StudyQuestion {
  id          String       @id @default(cuid())

  gapId       String
  gap         StudyGap     @relation(fields: [gapId], references: [id], onDelete: Cascade)

  position    Int
  question    String       @db.Text
  options     String[]
  answerIndex Int
  explanation String       @db.Text

  createdAt   DateTime     @default(now())

  @@index([gapId])
}

model StudyStrength {
  id          String @id @default(cuid())

  sectionId   String
  section     StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  skill       String
  importance  String @db.Text
  advice      String @db.Text
}

model StudyGap {
  id            String @id @default(cuid())

  sectionId     String
  section       StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  skill         String
  explanation   String @db.Text
  priority      String

  estimatedTime String

  topics        String[]
  resources     String[]

  // Gamificação: cada lacuna é um nível que precisa do quiz aprovado para liberar o próximo
  completed     Boolean   @default(false)
  completedAt   DateTime?
  bestScore     Int       @default(0)
  attempts      Int       @default(0)

  questions     StudyQuestion[]
}


model StudyPlan {
  id          String @id @default(cuid())

  sectionId   String
  section     StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  week        Int
  focus       String
  goals       String @db.Text
}

model Vacancy {
  id            String   @id @default(cuid())
  title         String
  description   String?
  company       String?
  level         String?
  modality      String?
  technologies  String[]
  link          String?
  origin        String?
  location      String?
  salary        String? @default("0")
  active        Boolean @default(true)

  // Recrutador que cadastrou a vaga (null = cadastrada pelo admin)
  createdById   String?
  createdBy     User?    @relation("VacancyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])

  study         Study[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Avaliations {
  id         String   @id @default(cuid())
  satisfied  Boolean
  comment    String?

  studyId    String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
}

model AvaliationsVacancys {
  id         String   @id @default(cuid())
  satisfied  Boolean
  comment    String?

  createdAt  DateTime @default(now())

  userId     String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
}

// Conversa com o agente. Sem studyId é o agente da plataforma (perfil), com studyId é o agente daquele estudo
model History {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  finishAt         DateTime?
  stopConversation Boolean  @default(false)

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  studyId          String?
  study            Study?   @relation(fields: [studyId], references: [id], onDelete: Cascade)

  messages         Messages[]

  @@index([userId, studyId])
}

model Messages {
  id         String   @id @default(cuid())
  isBot      Boolean
  text       String   @db.Text
  createdAt  DateTime @default(now())

  historyId  String
  history    History  @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([historyId])
}

// Assinatura mensal de um plano no Asaas
model Subscription {
  id                  String    @id @default(cuid())
  plan                String
  value               Float
  // PENDING (aguardando 1º pagamento), ACTIVE, OVERDUE, CANCELED
  status              String    @default("PENDING")
  asaasSubscriptionId String    @unique

  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  canceledAt          DateTime?

  payments            Payment[]

  @@index([userId, status])
}

// Cobranças do Asaas (mensalidades da assinatura e compras de créditos avulsos)
model Payment {
  id             String    @id @default(cuid())
  asaasPaymentId String    @unique
  // SUBSCRIPTION ou CREDITS
  type           String
  plan           String?
  packageId      String?
  credits        Int
  value          Float
  // Status do Asaas: PENDING, RECEIVED, CONFIRMED, OVERDUE, REFUNDED, DELETED...
  status         String    @default("PENDING")
  invoiceUrl     String?
  dueDate        DateTime?
  paidAt         DateTime?
  // Garante que os créditos de uma cobrança são liberados uma única vez
  credited       Boolean   @default(false)

  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
}

// Extrato de créditos: positivo é entrada, negativo é consumo. balance é o saldo total depois do lançamento
model CreditTransaction {
  id          String   @id @default(cuid())
  amount      Int
  // WELCOME, PLAN_RENEWAL, PURCHASE, VACANCY_REFRESH, STUDY, AGENT_MESSAGE, REFUND
  reason      String
  description String?
  referenceId String?
  balance     Int

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Última filtragem de vagas feita pela IA para o usuário (refeita grátis a cada 3 dias)
model VacancyFilter {
  id          String   @id @default(cuid())
  vacancyIds  String[]
  filteredAt  DateTime @default(now())

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Recrutador que pagou para ver os dados de um candidato. O acesso vale até expiresAt (60 dias) e pode ser renovado
model CandidateUnlock {
  id          String   @id @default(cuid())

  recruiterId String
  recruiter   User     @relation("UnlockRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   User     @relation("UnlockCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  unlockedAt  DateTime @default(now())
  expiresAt   DateTime

  @@unique([recruiterId, candidateId])
  @@index([candidateId])
}
